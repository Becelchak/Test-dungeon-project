  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E, \u044E\u043D\u044B\u0439 \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439!
    \u0417\u043E\u0432\u0438 \u043C\u0435\u043D\u044F... \u043A\u0430\u043A \u0442\u0435\u0431\u0435
    \u0443\u0434\u043E\u0431\u043D\u043E. \u042F - \u043B\u0438\u0448\u044C \u0442\u0435\u043D\u044C
    \u0431\u044B\u043B\u043E\u0433\u043E \u0432\u0435\u043B\u0438\u0447\u0438\u044F,
    \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u043D\u0430\u044F \u0432 \u043A\u043E\u0441\u0442\u044F\u043D\u043E\u0439
    \u0442\u044E\u0440\u044C\u043C\u0435. \u0418 \u0434\u0430, \u0442\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C
    \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u0441\u0430\u043C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0447\u0442\u043E \u0432\u044B\u043B\u0435\u0437 \u0438\u0437 \u043C\u043E\u0433\u0438\u043B\u044B.
    \u0417\u0430\u0434\u0430\u0432\u0430\u0439 \u0441\u0432\u043E\u0438 \n////////////////////\n/\n/\n///\n//////////////////////////"
